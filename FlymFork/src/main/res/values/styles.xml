<resources>

    <!-- Base application theme. -->
    <!-- <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style> -->


    <style name="styleApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="styleApp.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="styleApp.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ControlButton">
        <item name="android:layout_width">@dimen/entry_img_height</item>
        <item name="android:layout_height">@dimen/entry_img_height</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:visibility">gone</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- overflow/popup menu: black panel, yellow text (set as the toolbar popupTheme) -->
    <style name="ThemeOverlay.HandyRss.Popup" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:colorBackground">@color/menu_pref_bg</item>
        <item name="android:textColorPrimary">@color/menu_pref_fg</item>
        <item name="android:textColorSecondary">@color/menu_pref_fg</item>
        <item name="colorAccent">@color/menu_pref_fg</item>
        <item name="colorControlNormal">@color/menu_pref_fg</item>
        <item name="popupMenuStyle">@style/Widget.HandyRss.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.HandyRss.PopupMenu.Overflow</item>
    </style>

    <!-- HandyRss: yellow toolbar title + navigation/action icons on black -->
    <style name="ThemeOverlay.HandyRss.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/menu_pref_fg</item>
        <item name="android:textColorSecondary">@color/menu_pref_fg</item>
        <item name="colorControlNormal">@color/menu_pref_fg</item>
    </style>
    <style name="Widget.HandyRss.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/menu_pref_bg</item>
    </style>
    <style name="Widget.HandyRss.PopupMenu.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/menu_pref_bg</item>
    </style>
</resources>
