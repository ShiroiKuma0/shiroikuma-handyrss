<?xml version="1.0" encoding="utf-8"?>
<!-- HandyRss: kxkb-style FIRST section header — same as preference_font_topcat but without the
     full-width hairline above (nothing precedes the first section). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dip" android:paddingBottom="2dip">
    <LinearLayout
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="36dip">
        <TextView android:id="@android:id/title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/menu_pref_fg" android:textStyle="bold" android:textSize="20sp"/>
        <View android:layout_width="match_parent" android:layout_height="2.5dp"
            android:layout_marginTop="2dip" android:background="@color/menu_pref_fg"/>
    </LinearLayout>
</LinearLayout>
