<?xml version="1.0" encoding="utf-8"?>
<!-- HandyRss: Fonts sub-heading rendered as an underlined yellow label -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dip" android:paddingEnd="8dip"
    android:paddingTop="10dip" android:paddingBottom="4dip">
    <TextView android:id="@android:id/title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/font_subhead_underline"
        android:textColor="@color/menu_pref_fg" android:textStyle="bold" android:textSize="17sp"
        android:paddingBottom="5dip"/>
</LinearLayout>
