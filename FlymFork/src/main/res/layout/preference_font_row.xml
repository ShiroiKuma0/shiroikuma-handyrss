<?xml version="1.0" encoding="utf-8"?>
<!-- HandyRss: two-line font row (grey label / yellow value), indented inside its category -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_vertical"
    android:paddingStart="32dip" android:paddingEnd="8dip"
    android:paddingTop="2dip" android:paddingBottom="2dip">
    <TextView android:id="@android:id/title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FF989898" android:textSize="22dp"/>
    <TextView android:id="@android:id/summary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/menu_pref_fg" android:textSize="22dp"/>
</LinearLayout>
