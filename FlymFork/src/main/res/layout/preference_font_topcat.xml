<?xml version="1.0" encoding="utf-8"?>
<!-- HandyRss: top-level Fonts category header (Reading view / List view / Left toolbar) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dip" android:paddingEnd="8dip"
    android:paddingTop="16dip" android:paddingBottom="4dip">
    <TextView android:id="@android:id/title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/menu_pref_fg" android:textStyle="bold" android:textSize="22sp"/>
    <View android:layout_width="match_parent" android:layout_height="2dp"
        android:layout_marginTop="4dip" android:background="@color/menu_pref_fg"/>
</LinearLayout>
