<?xml version="1.0" encoding="utf-8"?>
<!-- HandyRss: kxkb-style top-level section header on the UI screen. A 1px full-width hairline
     separates this section from the previous one; the underline View sits inside a wrap_content
     container so it is exactly as wide as the heading text (kxkb look). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dip" android:paddingBottom="2dip">
    <View android:layout_width="match_parent" android:layout_height="1px"
        android:background="@color/menu_pref_fg"/>
    <LinearLayout
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="36dip" android:layout_marginTop="8dip">
        <TextView android:id="@android:id/title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/menu_pref_fg" android:textStyle="bold" android:textSize="20sp"/>
        <View android:layout_width="match_parent" android:layout_height="2.5dp"
            android:layout_marginTop="2dip" android:background="@color/menu_pref_fg"/>
    </LinearLayout>
</LinearLayout>
